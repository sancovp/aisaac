{
  // The site on Cloudflare: a Worker with static assets (worker.js runs first on every request).
  // Cloudflare builds and deploys it on every push to main. Secrets are set in the Worker's settings.
  "name": "aisaac",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // the domains (Cloudflare makes their DNS and certificates). A redirect domain is added here once it is bought;
  // worker.js already sends it to the address.
  "routes": [
    { "pattern": "iwantaiformybusiness.com", "custom_domain": true },
    { "pattern": "www.iwantaiformybusiness.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
